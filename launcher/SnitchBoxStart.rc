// Symbol und Versionsangabe des Starters (Versionsnummern kommen als /d-Definitionen vom Build-Skript).
#include <winver.h>

1 ICON "..\\src\\SnitchBox\\app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
 PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "justbox"
            VALUE "FileDescription", "SnitchBox Start"
            VALUE "FileVersion", VER_TEXT
            VALUE "InternalName", "SnitchBoxStart"
            VALUE "OriginalFilename", "SnitchBoxStart.exe"
            VALUE "ProductName", "SnitchBox"
            VALUE "ProductVersion", VER_PRODUCT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
