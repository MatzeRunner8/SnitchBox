<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Grün = erlauben, Rot = verbieten; überall dieselben zwei Farben (auch in Ui.Allow / Ui.Deny). -->
    <SolidColorBrush x:Key="AllowBrush" Color="#2EA043"/>
    <SolidColorBrush x:Key="DenyBrush" Color="#E0383E"/>

    <!-- Farbige Schaltfläche mit eigener Vorlage: die Systemvorlage würde die Farbe beim Überfahren durch Grau ersetzen. -->
    <Style x:Key="ColorButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#B0FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AllowButton" TargetType="Button" BasedOn="{StaticResource ColorButton}">
        <Setter Property="Background" Value="{StaticResource AllowBrush}"/>
    </Style>
    <Style x:Key="DenyButton" TargetType="Button" BasedOn="{StaticResource ColorButton}">
        <Setter Property="Background" Value="{StaticResource DenyBrush}"/>
    </Style>

    <!-- Die vier Bereiche des Hauptfensters als deutliche Schaltflächen: der gewählte Bereich ist blau gefüllt,
         die anderen haben Fläche und Rand, damit sie als anklickbar zu erkennen sind. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1F7AE0"/>
    <Style x:Key="NavButton" TargetType="RadioButton">
        <!-- Textfarbe des Fensters (folgt Hell/Dunkel); ohne diese Zeile gälte die klassische dunkle Systemfarbe, im
             Dunkelmodus kaum lesbar. Der gewählte Bereich hat weißen Text (Trigger unten). -->
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9,20,10"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="#22808080" BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#44808080"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Symbol vor dem Namen eines Bereichs (Symbolschrift von Windows 11, ersatzweise die von Windows 10). -->
    <Style x:Key="NavIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,1,9,0"/>
    </Style>

    <!-- Schaltfläche, die nur ihr Bild zeigt (Ko-fi-Knopf): ohne Systemrahmen, beim Überfahren leicht heller,
         mit Tastatur erreichbar (blauer Rand bei Fokus). -->
    <Style x:Key="ImageButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Padding="1" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Überschrift einer Gruppe in Regelliste und Programmliste (KI, Browser, Windows …): Name, Anzahl und eine feine Linie bis zum
         Rand. Nicht einklappbar – alles bleibt sichtbar. Die Gruppe ohne Namen (Zeile „Alle Programme“ im Netzwerkmonitor) hat keine. -->
    <DataTemplate x:Key="GroupHeader">
        <DockPanel x:Name="Panel" Margin="4,12,6,4">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Opacity="0.9" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" FontSize="13" Opacity="0.55" VerticalAlignment="Center"/>
            <Border Height="1" Background="#50808080" VerticalAlignment="Center" Margin="10,1,0,0"/>
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="">
                <Setter TargetName="Panel" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Ruhige Fläche zum Gruppieren; halbtransparentes Grau wirkt auf hellem wie dunklem Grund. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="#14808080"/>
        <Setter Property="BorderBrush" Value="#30808080"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>
    <Style x:Key="Dim" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.65"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,18,0,8"/>
    </Style>
    <!-- Farbiges Schildchen in Listen: „Erlauben“ / „Verbieten“ / „Fragt“. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="9,1,9,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</ResourceDictionary>
